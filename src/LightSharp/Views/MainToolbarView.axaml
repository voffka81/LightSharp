<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:LightSharp.Models"
             x:Class="LightSharp.Views.MainToolbarView">
  <Border Padding="8,4" Background="{DynamicResource BrushToolbarSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto">
      <Button Classes="toolbar-icon" Click="Save_Click" ToolTip.Tip="Save (Ctrl+S)"><Path Width="16" Height="16" Data="M2,1 L12,1 L15,4 L15,15 L1,15 L1,1 Z M4,1 L4,6 L11,6 L11,2 M4,9 L12,9 L12,14 L4,14 Z" Fill="Transparent" Stroke="{DynamicResource BrushTextChrome}" StrokeThickness="1.2"/></Button>
      <Border Grid.Column="1" Width="1" Height="22" Background="{DynamicResource BrushSeparator}" Margin="7,0" VerticalAlignment="Center"/>
      <ComboBox x:Name="ConfigurationSelector" Grid.Column="2" Width="88" Margin="2,0,5,0" FontSize="12" SelectedIndex="0" ToolTip.Tip="Solution configuration"><ComboBoxItem Content="Debug"/><ComboBoxItem Content="Release"/></ComboBox>
      <ComboBox Grid.Column="3" Width="100" Margin="2,0,5,0" FontSize="12" SelectedIndex="0" ToolTip.Tip="Solution platform"><ComboBoxItem Content="Any CPU"/></ComboBox>
      <Border Grid.Column="4" Width="1" Height="22" Background="{DynamicResource BrushSeparator}" Margin="5,0" VerticalAlignment="Center"/>
      <Button Grid.Column="5" Classes="launch" Width="30" Height="30" Padding="0" Click="Start_Click" ToolTip.Tip="Start"><Path Width="12" Height="14" Data="M2,1 L12,7 L2,13 Z" Fill="{DynamicResource BrushWhite}"/></Button>
      <ComboBox x:Name="StartupProjectSelector" Grid.Column="6" Width="175" Margin="6,0" FontSize="12" VerticalContentAlignment="Center" ToolTip.Tip="Startup project">
        <ComboBox.ItemTemplate><DataTemplate x:DataType="models:FileNode"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
      <Border Grid.Column="7" Width="1" Height="22" Background="{DynamicResource BrushSeparator}" Margin="5,0" VerticalAlignment="Center"/>
      <Button Grid.Column="8" Classes="toolbar-icon" Click="Build_Click" ToolTip.Tip="Build solution"><Path Width="17" Height="17" Data="M2,4 L6,1 L10,5 L8,7 L14,13 L12,15 L6,9 L4,11 L2,9 L4,7 Z" Fill="{DynamicResource BrushIcon}"/></Button>
      <Button Grid.Column="9" Classes="toolbar-icon" Click="Test_Click" ToolTip.Tip="Run tests"><Path Width="17" Height="17" Data="M5,1 L11,1 M7,1 L7,6 L3,13 Q2,15 5,15 L13,15 Q16,15 14,13 L9,6 L9,1 M5,11 L12,11" Stroke="{DynamicResource BrushIcon}" StrokeThickness="1.5"/></Button>
      <Button x:Name="StopButton" Grid.Column="10" Classes="toolbar-icon" Click="Stop_Click" IsEnabled="False" ToolTip.Tip="Stop"><Rectangle Width="10" Height="10" Fill="{DynamicResource BrushStop}"/></Button>
      <Border Grid.Column="11" Width="1" Height="22" Background="{DynamicResource BrushSeparator}" Margin="7,0" VerticalAlignment="Center"/>
      <TextBlock x:Name="WorkspaceText" Grid.Column="12" Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushTextMuted10}" FontSize="12" Text="No workspace"/>
      <TextBlock Grid.Column="13" VerticalAlignment="Center" Margin="8,0" Foreground="{DynamicResource BrushTextMuted}" FontSize="11" Text="Search"/>
      <TextBox x:Name="SearchBox" Grid.Column="14" Width="205" Height="29" VerticalContentAlignment="Center" FontSize="12" PlaceholderText="Search files  (Enter)" KeyDown="Search_KeyDown"/>
    </Grid>
  </Border>
</UserControl>

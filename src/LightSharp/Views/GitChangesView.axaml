<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="using:LightSharp.Services"
             x:Class="LightSharp.Views.GitChangesView">
  <Border Background="{DynamicResource BrushPanelSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,1,0">
    <Grid Background="{DynamicResource BrushPanelSurface}" RowDefinitions="Auto,*,Auto">
      <Grid Margin="8,5" RowDefinitions="Auto,Auto" RowSpacing="4">
        <TextBlock x:Name="RepoText" Foreground="{DynamicResource BrushTextMuted7}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <WrapPanel Grid.Row="1" Orientation="Horizontal">
          <Button x:Name="RefreshButton" Classes="chrome" Content="Refresh" Padding="8,3" Margin="0,0,5,3"/>
          <Button x:Name="StageAllButton" Classes="chrome" Content="Stage All" Padding="8,3" Margin="0,0,5,3"/>
          <Button x:Name="FetchButton" Classes="chrome" Content="Fetch" Padding="8,3" Margin="0,0,5,3"/>
          <Button x:Name="PullButton" Classes="chrome" Content="Pull" Padding="8,3" Margin="0,0,5,3"/>
          <Button x:Name="PushButton" Classes="chrome" Content="Push" Padding="8,3" Margin="0,0,5,3"/>
        </WrapPanel>
      </Grid>
      <Grid Grid.Row="1"><ListBox x:Name="ChangesList" Background="{DynamicResource BrushInsetSurface}">
          <ListBox.ItemTemplate><DataTemplate x:DataType="services:GitChange"><TextBlock Text="{Binding DisplayText}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" Margin="7,2"/></DataTemplate></ListBox.ItemTemplate>
        </ListBox><TextBlock x:Name="EmptyText" Text="No changes detected." Foreground="{DynamicResource BrushTextMuted4}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
      <Grid Grid.Row="2" RowDefinitions="Auto,Auto" Margin="8,4" RowSpacing="6"><TextBox x:Name="CommitMessageBox" Grid.Row="0" PlaceholderText="Commit message"/><Button x:Name="CommitButton" Grid.Row="1" HorizontalAlignment="Right" Classes="launch" Content="Commit All"/></Grid>
    </Grid>
  </Border>
</UserControl>

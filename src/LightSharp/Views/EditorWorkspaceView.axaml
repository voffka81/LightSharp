<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             xmlns:models="using:LightSharp.Models"
             x:Class="LightSharp.Views.EditorWorkspaceView">
  <Grid RowDefinitions="Auto,*" Background="{DynamicResource BrushEditorSurface}">
    <Border Grid.Row="0" Background="{DynamicResource BrushPanelSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><ItemsControl x:Name="Tabs"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:EditorDocument"><Grid ColumnDefinitions="Auto,Auto" Background="{DynamicResource BrushPanelSurface}"><Button Classes="doc-tab" Classes.active="{Binding IsActive}" Click="ActivateDocument_Click"><StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="7" Height="7" Fill="{DynamicResource BrushDocumentMarker}" IsVisible="{Binding IsDirty}"/><TextBlock Text="{Binding TabTitle}"/></StackPanel></Button><Button Classes="tab-close" Grid.Column="1" Content="×" Click="CloseDocument_Click"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><Button Grid.Column="1" Classes="chrome" Content="···" Margin="5,0"/></Grid>
    </Border>
    <Grid Grid.Row="1">
      <ae:TextEditor x:Name="TextEditor" ShowLineNumbers="True" FontFamily="Cascadia Code,Consolas,monospace" FontSize="13" Background="{DynamicResource BrushEditorSurface}" Foreground="{DynamicResource BrushTextPrimary}"/>
      <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" IsHitTestVisible="False"><TextBlock Text="◈" FontSize="34" Foreground="{DynamicResource BrushEmptyIcon}" HorizontalAlignment="Center"/><TextBlock Foreground="{DynamicResource BrushTextMuted5}" FontSize="14" Text="Open a source file to start editing"/><TextBlock Foreground="{DynamicResource BrushTextDim}" FontSize="11" Text="Choose a file from Solution Explorer" HorizontalAlignment="Center"/></StackPanel>
    </Grid>
  </Grid>
</UserControl>

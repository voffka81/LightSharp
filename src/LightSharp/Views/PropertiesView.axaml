<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LightSharp.Views.PropertiesView">
  <Border Background="{DynamicResource BrushPanelSurface}">
    <Grid RowDefinitions="Auto,*"><Border Padding="14,0" Height="42" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1"><TextBlock Classes="overline" Text="SOLUTION" VerticalAlignment="Center"/></Border><StackPanel Grid.Row="1" Margin="14" Spacing="10"><TextBlock Foreground="{DynamicResource BrushTextMuted8}" FontSize="11" Text="STARTUP PROJECT"/><TextBlock x:Name="StartupProjectText" Foreground="{DynamicResource BrushTextPrimary}" FontSize="13" Text="Select a project"/><Border Height="1" Background="{DynamicResource BrushBorder}" Margin="0,5"/><TextBlock Foreground="{DynamicResource BrushTextMuted8}" FontSize="11" Text="WORKSPACE"/><TextBlock x:Name="WorkspacePathText" Foreground="{DynamicResource BrushTextPrimary}" FontSize="12" Text="Open a folder to get started" TextWrapping="Wrap"/><Border Height="1" Background="{DynamicResource BrushBorder}" Margin="0,5"/><TextBlock Foreground="{DynamicResource BrushTextMuted8}" FontSize="11" Text="QUICK ACTIONS"/><Button x:Name="OpenFolderButton" Classes="chrome" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="＋  Open folder..."/><Button x:Name="BuildButton" Classes="chrome" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="⚒  Build solution"/></StackPanel></Grid>
  </Border>
</UserControl>

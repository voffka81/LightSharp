<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        xmlns:models="using:LightSharp.Models"
        xmlns:local="using:LightSharp"
        xmlns:services="using:LightSharp.Services"
        xmlns:views="using:LightSharp.Views"
        x:Class="LightSharp.MainWindow"
        Title="LightSharp" Width="1440" Height="900" MinWidth="1050" MinHeight="680"
        Background="{DynamicResource BrushEditorSurface}" Foreground="{DynamicResource BrushTextPrimary}" KeyDown="Window_KeyDown">
  <Grid x:Name="ShellGrid" RowDefinitions="Auto,Auto,*,Auto,Auto">
    <Border Grid.Row="0" Background="{DynamicResource BrushHeaderSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" Height="38">        
        <Menu Grid.Column="1" Background="Transparent" Padding="0" VerticalAlignment="Center">
          <MenuItem Header="File"><MenuItem Header="New Project...  Ctrl+Shift+N" Click="NewProject_Click"/><MenuItem Header="New File..." Click="NewFile_Click"/><Separator/><MenuItem Header="Open File...  Ctrl+O" Click="OpenFile_Click"/><MenuItem Header="Open Solution...  Ctrl+Shift+O" Click="OpenSolution_Click"/><MenuItem Header="Open Folder..." Click="OpenFolder_Click"/><Separator/><MenuItem Header="Save  Ctrl+S" Click="Save_Click"/><MenuItem Header="Save All  Ctrl+Shift+S" Click="SaveAll_Click"/></MenuItem>
          <MenuItem Header="Edit"><MenuItem Header="Find...  Ctrl+F" Click="Find_Click"/><MenuItem Header="Replace...  Ctrl+H" Click="Replace_Click"/><MenuItem Header="Find in Files...  Ctrl+Shift+F" Click="FindInFiles_Click"/><Separator/><MenuItem Header="Format Document  Ctrl+K, Ctrl+D" Click="FormatDocument_Click"/><MenuItem Header="Format Selection  Ctrl+K, Ctrl+F" Click="FormatSelection_Click"/><Separator/><MenuItem Header="Comment Selection  Ctrl+K, Ctrl+C" Click="Comment_Click"/><MenuItem Header="Uncomment Selection  Ctrl+K, Ctrl+U" Click="Uncomment_Click"/><Separator/><MenuItem Header="Select All  Ctrl+A" Click="SelectAll_Click"/></MenuItem>
          <MenuItem Header="View"><MenuItem Header="Focus Output" Click="FocusOutput_Click"/></MenuItem>
          <MenuItem x:Name="GitMenuItem" Header="Git"><MenuItem x:Name="GitChangesMenuItem" Header="Git Changes" Click="ShowGitChanges_Click" IsVisible="False"/><MenuItem x:Name="RefreshGitMenuItem" Header="Refresh Status" Click="RefreshGit_Click" IsVisible="False"/><Separator x:Name="GitMenuSeparator" IsVisible="False"/><MenuItem x:Name="InitializeGitMenuItem" Header="Initialize Repository" Click="InitializeGit_Click" IsVisible="False"/><MenuItem x:Name="StageAllGitMenuItem" Header="Stage All Changes" Click="StageAllGit_Click" IsVisible="False"/><MenuItem x:Name="CommitGitMenuItem" Header="Commit All..." Click="ShowGitChanges_Click" IsVisible="False"/></MenuItem><MenuItem Header="Build  Ctrl+Shift+B" Click="Build_Click"/><MenuItem Header="Debug"><MenuItem Header="Start  F5" Click="Start_Click"/><MenuItem Header="Start Without Debugging  Ctrl+F5" Click="Start_Click"/><MenuItem Header="Stop  Shift+F5" Click="Stop_Click"/></MenuItem><MenuItem Header="Test"><MenuItem Header="Run Tests  Ctrl+R, Ctrl+T" Click="Test_Click"/></MenuItem>
        </Menu>
        <TextBlock Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource BrushTextMuted6}" FontSize="11" Text="LightSharp  ·  Lightweight C# IDE" />
        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center" Spacing="4">
          <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource BrushTextMuted2}" FontSize="10" Text="IDE PREVIEW"/>
          <Ellipse Width="7" Height="7" Fill="{DynamicResource BrushAccentPositive}" VerticalAlignment="Center" Margin="4,0,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="1" Padding="8,4" Background="{DynamicResource BrushToolbarSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto">
        <Button Classes="toolbar-icon" Click="Save_Click" ToolTip.Tip="Save (Ctrl+S)"><Path Width="16" Height="16" Data="M2,1 L12,1 L15,4 L15,15 L1,15 L1,1 Z M4,1 L4,6 L11,6 L11,2 M4,9 L12,9 L12,14 L4,14 Z" Fill="Transparent" Stroke="{DynamicResource BrushTextChrome}" StrokeThickness="1.2"/></Button>
        <Border Grid.Column="1" Width="1" Height="22" Background="{DynamicResource BrushSeparator}" Margin="7,0" VerticalAlignment="Center"/>
        <ComboBox x:Name="ConfigurationSelector" Grid.Column="2" Width="88" Margin="2,0,5,0" FontSize="12" SelectedIndex="0" ToolTip.Tip="Solution configuration"><ComboBoxItem Content="Debug"/><ComboBoxItem Content="Release"/></ComboBox>
        <ComboBox Grid.Column="3" Width="100" Margin="2,0,5,0" FontSize="12" SelectedIndex="0" ToolTip.Tip="Solution platform"><ComboBoxItem Content="Any CPU"/></ComboBox>
        <Border Grid.Column="4" Width="1" Height="22" Background="{DynamicResource BrushSeparator}" Margin="5,0" VerticalAlignment="Center"/>
        <Button Grid.Column="5" Classes="launch" Width="30" Height="30" Padding="0" Click="Start_Click" ToolTip.Tip="Start"><Path Width="12" Height="14" Data="M2,1 L12,7 L2,13 Z" Fill="{DynamicResource BrushWhite}"/></Button>
        <ComboBox x:Name="StartupProjectSelector" Grid.Column="6" Width="175" Margin="6,0" FontSize="12" VerticalContentAlignment="Center" ToolTip.Tip="Startup project">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="models:FileNode"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <Border Grid.Column="7" Width="1" Height="22" Background="{DynamicResource BrushSeparator}" Margin="5,0" VerticalAlignment="Center"/>
        <Button Grid.Column="8" Classes="toolbar-icon" Click="Build_Click" ToolTip.Tip="Build solution"><Path Width="17" Height="17" Data="M2,4 L6,1 L10,5 L8,7 L14,13 L12,15 L6,9 L4,11 L2,9 L4,7 Z" Fill="{DynamicResource BrushIcon}"/></Button>
        <Button Grid.Column="9" Classes="toolbar-icon" Click="Test_Click" ToolTip.Tip="Run tests"><Path Width="17" Height="17" Data="M5,1 L11,1 M7,1 L7,6 L3,13 Q2,15 5,15 L13,15 Q16,15 14,13 L9,6 L9,1 M5,11 L12,11" Stroke="{DynamicResource BrushIcon}" StrokeThickness="1.5"/></Button>
        <Button x:Name="StopButton" Grid.Column="10" Classes="toolbar-icon" Click="Stop_Click" IsEnabled="False" ToolTip.Tip="Stop"><Rectangle Width="10" Height="10" Fill="{DynamicResource BrushStop}"/></Button>
        <Border Grid.Column="11" Width="1" Height="22" Background="{DynamicResource BrushSeparator}" Margin="7,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="WorkspaceText" Grid.Column="12" Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushTextMuted10}" FontSize="12" Text="No workspace"/>
        <TextBlock Grid.Column="13" VerticalAlignment="Center" Margin="8,0" Foreground="{DynamicResource BrushTextMuted}" FontSize="11" Text="Search"/>
        <TextBox x:Name="SearchBox" Grid.Column="14" Width="205" Height="29" VerticalContentAlignment="Center" FontSize="12" PlaceholderText="Search files  (Enter)" KeyDown="Search_KeyDown"/>
      </Grid>
    </Border>
    <Grid x:Name="WorkspaceArea" Grid.Row="2" ColumnDefinitions="48,248,1,*,1,280">
      <Border Grid.Column="0" Background="{DynamicResource BrushPanelSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,1,0">
        <StackPanel Spacing="5" Margin="0,13,0,0">
          <Border Height="38" BorderBrush="{DynamicResource BrushAccentBright}" BorderThickness="2,0,0,0" Background="{DynamicResource BrushActivityHover}"><TextBlock Text="▤" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource BrushTextPrimarySoft}"/></Border>
          <TextBlock Text="⌕" FontSize="20" HorizontalAlignment="Center" Foreground="{DynamicResource BrushTextMuted5}" Margin="0,5"/>
          <TextBlock Text="⑂" FontSize="20" HorizontalAlignment="Center" Foreground="{DynamicResource BrushTextMuted5}"/>
          <TextBlock Text="◇" FontSize="18" HorizontalAlignment="Center" Foreground="{DynamicResource BrushTextMuted5}"/>
        </StackPanel>
      </Border>
      <views:SolutionExplorerView x:Name="SolutionExplorerPanel" Grid.Column="1"/>
      <views:GitChangesView x:Name="GitChangesPanel" Grid.Column="1" IsVisible="False"/>
      <Border Grid.Column="2" Background="{DynamicResource BrushBorder}"/>
      <views:EditorWorkspaceView x:Name="EditorSurface" Grid.Column="3"/>
      <Border Grid.Column="4" Background="{DynamicResource BrushBorder}"/>
      <views:PropertiesView x:Name="PropertiesPanel" Grid.Column="5"/>
    </Grid>
    <views:OutputPanelView x:Name="OutputPanel" Grid.Row="3"/>
    <Border Grid.Row="4" Padding="10,4" Background="{DynamicResource BrushStatusSurface}" BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="0,1,0,0"><Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto"><TextBlock x:Name="BranchStatusText" Foreground="{DynamicResource BrushTextStatusLight}" FontSize="11" Text="⎇  No repository"/><TextBlock x:Name="EditorStatusText" Grid.Column="1" Margin="16,0,0,0" Foreground="{DynamicResource BrushTextStatus}" FontSize="11" Text="✓  Ready"/><TextBlock Grid.Column="2" Margin="16,0,0,0" Foreground="{DynamicResource BrushTextStatus}" FontSize="11" Text=".NET 10"/><TextBlock Grid.Column="4" Margin="12,0" Foreground="{DynamicResource BrushTextStatus}" FontSize="11" Text="C#"/><TextBlock x:Name="CursorStatusText" Grid.Column="5" Margin="12,0" Foreground="{DynamicResource BrushTextStatus}" FontSize="11" Text="Ln 1, Col 1"/><TextBlock x:Name="DiagnosticsText" Grid.Column="6" Margin="12,0" Foreground="{DynamicResource BrushTextStatus}" FontSize="11"/></Grid></Border>
  </Grid>
</Window>

